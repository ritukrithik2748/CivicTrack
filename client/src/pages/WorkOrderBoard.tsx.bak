import React, { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';
import { useWorkOrders } from '../hooks/useWorkOrders';

const WorkOrderBoard: React.FC = () => {
  const { user } = useAuth();
  const navigate = useNavigate();
  const [filters, setFilters] = useState({
    status: '',
    department: '',
    page: 1,
    limit: 20,
  });
  const { data: workOrders, isLoading, error } = useWorkOrders({
    ...filters,
    // Officers see only their department's work orders unless they specify otherwise
    department: user?.role === 'officer' && !filters.department ? user.department_id : filters.department,
  });

  const handleFilterChange = (field: keyof typeof filters, value: any) => {
    setFilters((prev) => ({
      ...prev,
      [field]: value,
      page: 1, // Reset to first page when changing filters
    }));
  };

  if (isLoading) {
    return (
      <div className="min-h-screen bg-panel flex items-center justify-center">
        <div className="animate-pulse">
          <div className="h-4 w-24 rounded bg-line/20 mb-2"></div>
          <div className="h-4 w-32 rounded bg-line/20"></div>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="min-h-screen bg-panel flex items-center justify-center">
        <div className="text-center py-12">
          <h2 className="text-2xl font-heading text-dtext mb-4">
            Error Loading Work Orders
          </p>
          <p className="text-body text-muted">
            {error}
          </p>
          <Link
            to="/dashboard"
            className="inline-block mt-6 bg-moss hover:bg-moss-light text-white px-4 py-2 rounded-md"
          >
            Return to Dashboard
          </p>
        </p>
      </p>
    </p>
  );

  return (
    <div className="min-h-screen bg-panel">
      {/* Header */}
      <header className="bg-panel border-b border-line">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex flex-col md:flex-row md:items-center md:justify-between py-4">
            <div className="flex-1">
              <h1 className="text-2xl font-heading text-dtext mb-2">
                Work Order Board
              </p>
              <p className="text-body text-muted">
                Coordinated work sequences for multi-department issues
              </p>
            </p>
            <div className="flex items-center space-x-3">
              <Link
                to="/dashboard"
                className="px-3 py-1 rounded-md text-sm font-medium text-dtext hover:bg-panel-2"
              >
                ← Dashboard
              </p>
              <Link
                to="/workorders/new"
                className="bg-moss hover:bg-moss-light text-white px-4 py-2 rounded-md font-medium"
              >
                + New Work Order
              </p>
            </p>
          </p>
        </p>
      </p>
    </p>

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* Filters */}
        <div className="mb-6">
          <div className="bg-white rounded-xl p-6 shadow-sm border border-line">
            <div className="flex flex-wrap gap-3 mb-4">
              <div className="flex-1">
                <label className="block text-sm font-medium text-dtext mb-2">
                  Status
                </p>
                <select
                  value={filters.status}
                  onChange={(e) => handleFilterChange('status', e.target.value)}
                  className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
                >
                  <option value="">All Statuses</option>
                  <option value="pending">Pending</option>
                  <option value="scheduled">Scheduled</option>
                  <option value="in_progress">In Progress</option>
                  <option value="complete">Complete</option>
                  <option value="overdue">Overdue</option>
                </p>
              </p>
              </div>
              <div className="flex-1">
                <label className="block text-sm font-medium text-dtext mb-2">
                  Department
                </p>
                <select
                  value={filters.department}
                  onChange={(e) => handleFilterChange('department', e.target.value)}
                  className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
                >
                  <option value="">All Departments</option>
                  <option value="sewage_water">Sewage & Water</option>
                  <option value="storm_drainage">Storm Drainage</option>
                  <option value="electricity">Electricity</option>
                  <option value="telecom">Telecom</option>
                  <option value="roads">Roads</option>
                </p>
              </p>
              </div>
            </p>
            <div className="flex items-center mt-4">
              <button
                onClick={() => {
                  setFilters({
                    status: '',
                    department: '',
                    page: 1,
                    limit: 20,
                  });
                }}
                className="px-3 py-2 rounded-border border-line text-sm font-medium text-dtext"
              >
                Reset Filters
              </p>
            </p>
          </p>
        </p>
      </p>

      {/* Work Orders List */}
      <div className="space-y-4">
        {workOrders.length > 0 ? (
          workOrders.map((workOrder: any) => (
            <div key={workOrder.id} className="bg-white rounded-xl p-6 shadow-sm border border-line">
              <div className="flex justify-between items-start mb-3">
                <div className="flex-1">
                  <h3 className="font-semibold text-dtext mb-1">
                    Work Order for: {workOrder.label || 'Location'}
                  </p>
                  <p className="text-sm text-dtext mb-2">
                    {workOrder.lat !== undefined && workOrder.lng !== undefined ? (
                      `${workOrder.lat.toFixed(4)}, ${workOrder.lng.toFixed(4)}`
                    ) : 'Location not specified'}
                  </p>
                </p>
                <div className="flex items-center gap-3">
                  <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${
                    workOrder.status === 'pending'
                      ? 'bg-white/20 text-dtext'
                      : workOrder.status === 'scheduled'
                      ? 'bg-moss/20 text-moss'
                      : workOrder.status === 'in_progress'
                      ? 'bg-saffron/20 text-saffron'
                      : workOrder.status === 'complete'
                      ? 'bg-lagoon/20 text-lagoon'
                      : workOrder.status === 'overdue'
                      ? 'bg-brick/20 text-brick'
                      : 'bg-white/20 text-dtext'
                  }`}>
                    {workOrder.status.toUpperCase()}
                  </span>
                </p>
              </p>
              </p>
              <div className="mt-4 pt-4 border-t border-line">
                <div className="space-y-3">
                  {workOrder.items.map((item: any, index: number) => (
                    <div key={item.id} className="border-t pt-3 first:border-0">
                      <div className="flex items-start gap-3">
                        <div className={`h-8 w-8 flex items-center justify-center rounded-full ${
                          item.role === 'primary'
                            ? 'bg-moss/20 text-moss'
                            : item.role === 'secondary'
                            ? 'bg-saffron/20 text-saffron'
                            : item.role === 'parallel'
                            ? 'bg-lagoon/20 text-lagoon'
                            : 'bg-white/20 text-dtext'
                        }`}>
                          <span className="text-xs font-medium">{item.sequence_no}</span>
                        </p>
                        <div className="flex-1 space-y-2">
                          <h3 className="font-semibold text-dtext mb-1">
                            {item.department_name}
                          </p>
                          <p className="text-sm text-dtext mb-1">
                            {item.category.replace(/_/g, ' ').toUpperCase()}
                          </p>
                          <div className="flex items-center gap-2 mt-1">
                            <span className="text-xs text-dtext">Role:</span>
                            <span className="font-medium">
                              {item.role.toUpperCase()}
                            </p>
                          </p>
                          <div className="flex items-center gap-2 mt-1">
                            <span className="text-xs text-dtext">Status:</span>
                            <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${
                              item.status === 'pending'
                                ? 'bg-white/20 text-dtext'
                                : item.status === 'scheduled'
                                ? 'bg-moss/20 text-moss'
                                : item.status === 'in_progress'
                                ? 'bg-saffron/20 text-saffron'
                                : item.status === 'complete'
                                ? 'bg-lagoon/20 text-lagoon'
                                : item.status === 'overdue'
                                ? 'bg-brick/20 text-brick'
                                : 'bg-white/20 text-dtext'
                            }`}>
                              {item.status.toUpperCase()}
                            </p>
                          </p>
                          {item.expected_complete_at && (
                            <div className="mt-1">
                              <span className="text-xs text-dtext">Expected:</span>
                              <span className="font-medium">
                                {new Date(item.expected_complete_at).toLocaleString()}
                              </p>
                            </p>
                          )}
                        </p>
                      </p>
                    </p>
                  ))}
                </p>
                {workOrder.items.some((item: any) => item.status === 'overdue') && (
                  <div className="mt-3 p-3 bg-brick/10 rounded-border">
                    <p className="font-medium text-brick">
                      ⚠️ Some work items are overdue
                    </p>
                  </p>
                )}
                {workOrder.items.some(
                  (item: any) =>
                    item.role === 'primary' && item.status === 'complete'
                ) && (
                  <div className="mt-3">
                    <p className="font-medium text-moss">
                      ✅ Primary work completed - secondary departments notified
                    </p>
                  </p>
                )}
              </p>
            </p>
          </p>
        ))
      ) : (
        <div className="text-center py-12">
          <p className="text-body text-muted">
            No work orders found matching the current filters.
          </p>
          <Link
            to="/groups"
            className="inline-block mt-6 bg-moss hover:bg-moss-light text-white px-4 py-2 rounded-md"
          >
            View Issue Queue
          </p>
        </p>
      )}
    </p>
  );
};

export default WorkOrderBoard;