import React, { useState, useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';
import { useNotifications } from '../contexts/NotificationContext';

const Conflicts: React.FC = () => {
  const { user } = useAuth();
  const { unreadCount } = useNotifications();
  const [conflicts, setConflicts] = useState<any[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    fetchConflicts();
  }, []);

  const fetchConflicts = async () => {
    try {
      setIsLoading(true);
      const response = await fetch('/api/conflicts', {
        credentials: 'include',
      });
      if (response.ok) {
        const data = await response.json();
        setConflicts(data.data || []);
      } else {
        setError('Failed to fetch conflicts');
      }
    } catch (err) {
      setError('Failed to fetch conflicts');
    } finally {
      setIsLoading(false);
    }
  };

  const handleResolve = async (conflictId: string, status: 'acknowledged' | 'resolved' | 'merged') => {
    if (!user) return;
    try {
      const response = await fetch(`/api/conflicts/${conflictId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
        credentials: 'include',
      });
      if (response.ok) {
        fetchConflicts();
      }
    } catch (err) {
      console.error('Failed to resolve conflict:', err);
    }
  };

  if (isLoading) {
    return (
      <div className="min-h-screen bg-panel flex items-center justify-center">
        <div className="animate-pulse">
          <div className="h-4 w-24 rounded bg-line/20 mb-2"></div>
          <div className="h-4 w-32 rounded bg-line/20"></div>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="min-h-screen bg-panel flex items-center justify-center">
        <div className="text-center py-12">
          <h2 className="text-2xl font-heading text-dtext mb-4">Error Loading Conflicts</h2>
          <p className="text-body text-muted">{error}</p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-panel">
      {/* Header */}
      <header className="bg-panel border-b border-line">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex flex-col md:flex-row md:items-center md:justify-between py-4">
            <div className="flex-1">
              <h1 className="text-2xl font-heading text-dtext mb-2">Dig-Once Conflicts</h1>
              <p className="text-body text-muted">Detected scheduling conflicts between projects</p>
            </div>
            <div className="flex items-center space-x-3">
              <Link to="/dashboard" className="px-3 py-1 rounded-md text-sm font-medium text-dtext hover:bg-panel-2">← Dashboard</Link>
            </div>
          </div>
        </div>
      </header>

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div className="bg-white rounded-xl shadow-sm border border-line overflow-hidden">
          <div className="overflow-x-auto">
            <table className="w-full">
              <thead className="bg-panel">
                <tr>
                  <th className="px-4 py-3 text-left text-xs font-medium text-muted">Project A</th>
                  <th className="px-4 py-3 text-left text-xs font-medium text-muted">Project B</th>
                  <th className="px-4 py-3 text-left text-xs font-medium text-muted">Distance</th>
                  <th className="px-4 py-3 text-left text-xs font-medium text-muted">Time Gap</th>
                  <th className="px-4 py-3 text-left text-xs font-medium text-muted">Suggestion</th>
                  <th className="px-4 py-3 text-left text-xs font-medium text-muted">Status</th>
                  <th className="px-4 py-3 text-left text-xs font-medium text-muted">Actions</th>
                </tr>
              </thead>
              <tbody className="divide-y divide-line">
                {conflicts.map((conflict: any) => (
                  <tr key={conflict.id} className="hover:bg-panel/50">
                    <td className="px-4 py-3">
                      <div>
                        <p className="font-medium text-dtext">{conflict.project_a_title}</p>
                        <p className="text-xs text-muted">
                          {conflict.project_a_road} • {conflict.project_a_ward}
                        </p>
                      </div>
                    </td>
                    <td className="px-4 py-3">
                      <div>
                        <p className="font-medium text-dtext">{conflict.project_b_title}</p>
                        <p className="text-xs text-muted">
                          {conflict.project_b_road} • {conflict.project_b_ward}
                        </p>
                      </div>
                    </td>
                    <td className="px-4 py-3 text-sm text-dtext">
                      {conflict.distance_m ? `${Math.round(conflict.distance_m)}m` : 'N/A'}
                    </td>
                    <td className="px-4 py-3 text-sm text-dtext">
                      {conflict.gap_days ? `${conflict.gap_days} days` : 'Overlapping'}
                    </td>
                    <td className="px-4 py-3 text-sm text-muted max-w-xs truncate">
                      {conflict.suggestion}
                    </td>
                    <td className="px-4 py-3">
                      <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${
                        conflict.status === 'open' ? 'bg-brick/20 text-brick' :
                        conflict.status === 'acknowledged' ? 'bg-saffron/20 text-saffron' :
                        conflict.status === 'resolved' ? 'bg-lagoon/20 text-lagoon' :
                        conflict.status === 'merged' ? 'bg-moss/20 text-moss' :
                        'bg-white/20 text-dtext'
                      }`}>
                        {conflict.status.toUpperCase()}
                      </span>
                    </td>
                    <td className="px-4 py-3">
                      <div className="flex items-center gap-2">
                        {conflict.status === 'open' && (
                          <>
                            <button
                              onClick={() => handleResolve(conflict.id, 'acknowledged')}
                              className="px-2 py-1 rounded text-xs font-medium bg-saffron/20 text-saffron hover:bg-saffron/30"
                            >
                              Acknowledge
                            </button>
                            <button
                              onClick={() => handleResolve(conflict.id, 'merged')}
                              className="px-2 py-1 rounded text-xs font-medium bg-moss/20 text-moss hover:bg-moss/30"
                            >
                              Mark Merged
                            </button>
                          </>
                        )}
                        {conflict.status === 'acknowledged' && (
                          <button
                            onClick={() => handleResolve(conflict.id, 'resolved')}
                            className="px-2 py-1 rounded text-xs font-medium bg-lagoon/20 text-lagoon hover:bg-lagoon/30"
                          >
                            Resolve
                          </button>
                        )}
                        {conflict.status === 'resolved' || conflict.status === 'merged' && (
                          <span className="text-xs text-muted">Completed</span>
                        )}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        {conflicts.length === 0 && (
          <div className="text-center py-12">
            <div className="w-16 h-16 mx-auto mb-4 bg-lagoon/10 rounded-full flex items-center justify-center">
              <span className="text-lagoon">✅</span>
            </div>
            <h3 className="text-xl font-heading text-dtext mb-2">No Conflicts Detected</h3>
            <p className="text-body text-muted">No dig-once conflicts found in the current project schedule.</p>
          </div>
        )}
      </div>
    </div>
  );
};

export default Conflicts;