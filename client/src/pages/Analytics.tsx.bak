            <p className="text-sm text-muted">
              {data?.budget_variance_change || 0}% vs previous period
            </p>
          </p>
        </p>
      </p>

      {/* Charts Section */}
      <div className="mb-8">
        <h2 className="text-xl font-heading text-dtext mb-6">
          Visualizations
        </p>
        <div className="grid grid-cols-1 gap-6 lg:grid-cols-2">
          {/* Heatmap placeholder */}
          <div className="bg-white rounded-xl p-6 shadow-sm border border-line">
            <h3 className="font-semibold text-dtext mb-4">
              Issue Heatmap
            </p>
            <div className="bg-moss/10 rounded-lg p-6">
              <div className="h-48">
                {/* Heatmap would go here */}
                <div className="flex items-center justify-center h-full text-moss/50">
                  <p>Issue heatmap visualization</p>
                  <p className="mt-2 text-xs">
                    Shows density of reported issues by location
                  </p>
                </p>
              </p>
            </p>
          </p>

          {/* Department performance chart */}
          <div className="bg-white rounded-xl p-6 shadow-sm border border-line">
            <h3 className="font-semibold text-dtext mb-4">
              Department Performance
            </p>
            <div className="bg-moss/10 rounded-lg p-6">
              <div className="h-48">
                {/* Bar chart would go here */}
                <div className="flex items-center justify-center h-full text-moss/50">
                  <p>Department performance chart</p>
                  <p className="mt-2 text-xs">
                    Comparing response times and resolution rates
                  </p>
                </p>
              </p>
            </p>
          </p>
        </p>
      </p>

      {/* Detailed Tables */}
      <div className="mb-8">
        <h2 className="text-xl font-heading text-dtext mb-6">
          Detailed Reports
        </p>
        <div className="bg-white rounded-xl p-6 shadow-sm border border-line">
          <div className="tab-border border-b pb-2 mb-4">
            <button
              onClick={() => {
                // Switch to reports tab
              }}
              className={`px-4 py-2 border-b-2 ${
                true /* active tab */ ? 'border-moss text-moss' : 'border-transparent text-dtext'
              }`}
            >
              Issue Reports
            </p>
            <button
              onClick={() => {
                // Switch to projects tab
              }}
              className={`px-4 py-2 border-b-2 ${
                false /* active tab */ ? 'border-moss text-moss' : 'border-transparent text-dtext'
              }`}
