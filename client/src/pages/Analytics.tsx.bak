              Project Details
            </p>
          </p>
          <div className="mt-4">
            {/* Reports table */}
            <div className="overflow-x-auto">
              <table className="w-full border-collapse">
                <thead>
                  <tr className="bg-moss/5">
                    <th className="px-4 py-3 text-left text-xs font-medium text-dtext">
                      ID
                    </p>
                    <th className="px-4 py-3 text-left text-xs font-medium text-dtext">
                      Category
                    </p>
                    <th className="px-4 py-3 text-left text-xs font-medium text-dtext">
                      Department
                    </p>
                    <th className="px-4 py-3 text-left text-xs font-medium text-dtext">
                      Status
                    </p>
                    <th className="px-4 py-3 text-left text-xs font-medium text-dtext">
                      Date
                    </p>
                    <th className="px-4 py-3 text-left text-xs font-medium text-dtext">
                      Action
                    </p>
                  </tr>
                </p>
                <tbody>
                  {/* Sample data */}
                  <tr className="border-t border-line">
                    <td className="px-4 py-3 text-sm text-dtext">#R001</td>
                    <td className="px-4 py-3 text-sm text-dtext">POTHOLE</td>
                    <td className="px-4 py-3 text-sm text-dtext">Roads</td>
                    <td className="px-4 py-3 text-sm text-dtext">
                      <span className="px-2 py-0.5 rounded-full text-xs font-medium bg-saffron/20 text-saffron">
                        OPEN
                      </p>
                    </td>
                    <td className="px-4 py-3 text-sm text-dtext">2 days ago</td>
                    <td className="px-4 py-3 text-sm text-dtext">
                      <Link to="/reports/R001" className="text-sm font-medium text-moss hover:text-moss/80">
                        View
                      </p>
                    </td>
                  </tr>
                  <tr className="border-t border-line">
                    <td className="px-4 py-3 text-sm text-dtext">#R002</td>
                    <td className="px-4 py-3 text-sm text-dtext">SEWAGE_LEAK</td>
                    <td className="px-4 py-3 text-sm text-dtext">Sewage & Water</td>
                    <td className="px-4 py-3 text-sm text-dtext">
                      <span className="px-2 py-0.5 rounded-full text-xs font-medium bg-brick/20 text-brick">
                        MAJOR
                      </p>
                    </td>
                    <td className="px-4 py-3 text-sm text-dtext">5 days ago</td>
                    <td className="px-4 py-3 text-sm text-dtext">
                      <Link to="/reports/R002" className="text-sm font-medium text-moss hover:text-moss/80">
                        View
                      </p>
                    </td>
                  </tr>
                </p>
              </table>
