import React, { useState, useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';
import { useNotifications } from '../contexts/NotificationContext';
import { useDisruptions } from '../hooks/useReports';

const DisruptionPlanner: React.FC = () => {
  const { user } = useAuth();
  const { unreadCount } = useNotifications();
  const [days, setDays] = useState(7);
  const { data, isLoading, error } = useDisruptions(days);

  if (isLoading) {
    return <div className="min-h-screen bg-paper flex items-center justify-center"><div className="animate-pulse space-y-2"><div className="h-4 w-24 rounded bg-ink-soft/20"></div><div className="h-4 w-32 rounded bg-ink-soft/20"></div></div></div>;
  }

  if (error) {
    return <div className="min-h-screen bg-paper flex items-center justify-center"><div className="text-center py-12"><h2 className="text-2xl font-heading text-ink mb-4">Error Loading Disruptions</h2><p className="text-body text-ink-soft">{error}</p></div></div>;
  }

  return (
    <div className="min-h-screen bg-paper">
      <header className="bg-paper-2 border-b border-hairline"><div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div className="flex flex-col md:flex-row md:items-center md:justify-between py-4"><div className="flex-1"><h1 className="text-2xl font-heading text-ink mb-2">Avoid This Road</h1><p className="text-body text-ink-soft">Plan your route around upcoming road works and closures</p></div><div className="flex items-center space-x-3"><Link to="/" className="px-3 py-1 rounded-md text-sm font-medium text-ink hover:bg-paper-2">← Home</Link></div></div></div></header>
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div className="mb-8"><div className="bg-white rounded-xl p-6 shadow-sm border border-hairline"><div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4"><h2 className="text-xl font-heading text-ink">Upcoming Disruptions</h2><div className="flex items-center gap-3"><label className="text-sm font-medium text-ink">Time horizon:</label><select value={days} onChange={e => setDays(parseInt(e.target.value))} className="px-3 py-2 rounded-border border-hairline focus:border-moss focus:ring-2 focus:ring-moss/20"><option value={7}>Next 7 days</option><option value={14}>Next 14 days</option><option value={30}>Next 30 days</option></select></div></div></div></div>
        <div className="space-y-4">
          {data?.disruptions?.length > 0 ? data.disruptions.map((road: any) => (<div key={road.road_name} className="bg-white rounded-xl p-6 shadow-sm border border-hairline"><div className="flex flex-col md:flex-row md:items-center md:justify-between mb-4"><h3 className="text-lg font-heading text-ink">{road.road_name}</h3><div className="flex items-center gap-3 mt-2 md:mt-0"><span className="px-3 py-1 rounded-full text-xs font-medium bg-moss/20 text-moss">{road.projects.length} project{road.projects.length > 1 ? 's' : ''}</span><span className="px-3 py-1 rounded-full text-xs font-medium bg-saffron/20 text-saffron">{road.earliest_start ? `From ${new Date(road.earliest_start).toLocaleDateString()}` : 'Date TBD'}</span></div></div><div className="space-y-3">{road.projects.map((project: any) => (<div key={project.id} className="p-4 bg-paper/50 rounded-lg border border-hairline"><div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3"><div className="flex-1"><h4 className="font-medium text-ink">{project.title}</h4><p className="text-sm text-ink-soft">{project.department_name}</p></div><div className="flex items-center gap-3 text-sm"><span className={`px-2 py-0.5 rounded-full text-xs font-medium ${project.status === 'planned' ? 'bg-moss/20 text-moss' : project.status === 'in_progress' ? 'bg-saffron/20 text-saffron' : 'bg-lagoon/20 text-lagoon'}`}>{project.status.replace('_', ' ').toUpperCase()}</span><span className="text-ink-soft">{project.planned_end ? `Until ${new Date(project.planned_end).toLocaleDateString()}` : 'Ongoing'}</span><Link to={`/projects/${project.id}`} className="text-moss hover:text-moss/80 underline text-sm">Details</Link></div></div>))}) : <div className="text-center py-12"><div className="w-16 h-16 mx-auto mb-4 bg-lagoon/10 rounded-full flex items-center justify-center"><span className="text-lagoon">🛣️</span></div><h3 className="text-xl font-heading text-ink mb-2">No Upcoming Disruptions</h3><p className="text-body text-ink-soft">No road works or closures scheduled in the next {days} days.</p></div>} )}
        </div>
      </div>
    </div>
  );
};

export default DisruptionPlanner;