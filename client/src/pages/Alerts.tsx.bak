import React, { useState, useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';
import { useNotifications } from '../contexts/NotificationContext';
import { useSubscriptions } from '../hooks/useReports';

const Alerts: React.FC = () => {
  const { user } = useAuth();
  const { notifications, unreadCount, markAsRead, markAllAsRead, fetchNotifications } = useNotifications();
  const { data: subscriptions, isLoading: subsLoading } = useSubscriptions();
  const [showCreateModal, setShowCreateModal] = useState(false);
  const [subscriptionForm, setSubscriptionForm] = useState({
    kind: 'ward',
    ward: '',
    center_lat: null as number | null,
    center_lng: null as number | null,
    radius_m: 1000,
    road_name: '',
  });

  useEffect(() => {
    if (user) fetchNotifications();
  }, [user]);

  const handleSubscriptionSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!user) return;
    try {
      const response = await fetch('/api/subscriptions', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(subscriptionForm), credentials: 'include' });
      if (response.ok) { setShowCreateModal(false); setSubscriptionForm({ kind: 'ward', ward: '', center_lat: null, center_lng: null, radius_m: 1000, road_name: '' }); }
    } catch (err) { console.error('Failed to create subscription:', err); }
  };

  if (!user) {
    return <div className="min-h-screen bg-paper flex items-center justify-center"><div className="text-center py-12"><h2 className="text-2xl font-heading text-ink mb-4">Please Log In</h2><p className="text-body text-ink-soft mb-6">You need to be logged in to manage alerts and subscriptions.</p><Link to="/login" className="bg-moss hover:bg-moss-light text-white px-6 py-3 rounded-md">Login</Link></div></div>;
  }

  return (
    <div className="min-h-screen bg-paper">
      <header className="bg-paper-2 border-b border-hairline"><div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div className="flex flex-col md:flex-row md:items-center md:justify-between py-4"><div className="flex-1"><h1 className="text-2xl font-heading text-ink mb-2">Alerts & Notifications</h1><p className="text-body text-ink-soft">Manage your subscriptions and view notifications</p></div><div className="flex items-center space-x-3"><Link to="/" className="px-3 py-1 rounded-md text-sm font-medium text-ink hover:bg-paper-2">← Home</Link></div></div></div></header>
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div className="lg:col-span-1"><div className="bg-white rounded-xl p-6 shadow-sm border border-line h-fit sticky top-24"><div className="flex justify-between items-center mb-4"><h2 className="text-xl font-heading text-ink">Subscriptions</h2><button onClick={() => setShowCreateModal(true)} className="bg-moss hover:bg-moss-light text-white px-3 py-1.5 rounded-md text-sm font-medium">+ Add</button></div>
            {subsLoading ? <div className="space-y-3"><div className="animate-pulse h-12 bg-paper rounded-lg"></div><div className="animate-pulse h-12 bg-paper rounded-lg"></div></div> : subscriptions?.length > 0 ? <div className="space-y-3">{subscriptions.map((sub: any) => (<div key={sub.id} className="p-3 bg-paper/50 rounded-lg border border-hairline"><div className="flex items-center justify-between"><div className="flex items-center gap-2"><span className={`px-2 py-0.5 rounded-full text-xs font-medium ${sub.kind === 'ward' ? 'bg-moss/20 text-moss' : sub.kind === 'circle' ? 'bg-saffron/20 text-saffron' : 'bg-lagoon/20 text-lagoon'}`}>{sub.kind}</span><span className="text-sm font-medium text-ink">{sub.kind === 'ward' ? `Ward ${sub.ward}` : sub.kind === 'circle' ? `${sub.radius_m}m radius` : `Road: ${sub.road_name}`}</span></div><button onClick={() => fetch(`/api/subscriptions/${sub.id}`, { method: 'DELETE', credentials: 'include' })} className="text-xs text-brick hover:text-brick/80">Remove</button></div>))} : <div className="text-center py-8 text-ink-soft"><p className="mb-4">No subscriptions yet</p><button onClick={() => setShowCreateModal(true)} className="text-sm font-medium text-moss hover:text-moss/80">Create your first subscription</button></div>} </div></div>
          <div className="lg:col-span-2"><div className="bg-white rounded-xl p-6 shadow-sm border border-line"><div className="flex justify-between items-center mb-4"><h2 className="text-xl font-heading text-ink">Notifications {unreadCount > 0 && <span className="ml-2 px-2 py-0.5 rounded-full bg-saffron/20 text-saffron text-xs font-medium">{unreadCount}</span>}</h2>{unreadCount > 0 && <button onClick={() => markAllAsRead()} className="text-sm font-medium text-moss hover:text-moss/80">Mark all as read</button>}</div>
            {notifications.length > 0 ? <div className="space-y-3">{notifications.map((notif: any) => (<div key={notif.id} className={`p-4 ${!notif.read ? 'bg-moss/5' : ''}`}><div className="flex items-start gap-3"><div className="flex-shrink-0"><span className={`px-2 py-0.5 rounded-full text-xs font-medium ${notif.type === 'reply' ? 'bg-lagoon/20 text-lagoon' : notif.type === 'reopen' ? 'bg-saffron/20 text-saffron' : notif.type === 'escalation' ? 'bg-brick/20 text-brick' : notif.type === 'delay' ? 'bg-saffron/20 text-saffron' : notif.type === 'work_scheduled' ? 'bg-moss/20 text-moss' : notif.type === 'verified' ? 'bg-lagoon/20 text-lagoon' : notif.type === 'dispute' ? 'bg-disputed/20 text-disputed' : notif.type === 'reassignment' ? 'bg-saffron/20 text-saffron' : notif.type === 'released' ? 'bg-moss/20 text-moss' : notif.type === 'early_warning' ? 'bg-brick/20 text-brick' : 'bg-ink/20 text-dtext'}`}>{notif.type}</span></div><div className="flex-1 min-w-0"><div className="flex items-start justify-between gap-3"><div><h3 className={`font-medium ${!notif.read ? 'text-dtext' : 'text-muted'}`}>{notif.title}</h3><p className={`text-sm ${!notif.read ? 'text-dtext' : 'text-muted'} mt-1`}>{notif.body}</p></div><div className="flex items-center gap-2 flex-shrink-0"><span className="text-xs text-muted">{new Date(notif.created_at).toLocaleString()}</span>{notif.link && <a href={notif.link} className="px-2 py-1 text-xs font-medium text-moss hover:text-moss/80 bg-moss/10 rounded">View</a>}{!notif.read && <button onClick={() => markAsRead(notif.id)} className="p-1 text-muted hover:text-moss" aria-label="Mark as read"><svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg></button>}</div></div></div></div>))} : <div className="text-center py-12 text-muted"><p>{notifications.filter(n => !n.read).length === 0 && unreadCount === 0 ? 'No notifications yet' : 'No unread notifications'}</p></div>} {unreadCount > 0 && <div className="mt-4 pt-4 border-t border-line"><button onClick={() => markAllAsRead()} className="w-full bg-saffron/10 hover:bg-saffron/20 text-saffron px-4 py-2 rounded-md font-medium">Mark all {unreadCount} as read</button></div>} </div></div>
        </div>
      </div>

      {showCreateModal && <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4"><div className="bg-white rounded-xl p-6 max-w-md w-full"><h2 className="text-xl font-heading text-ink mb-4">Create Subscription</h2><form onSubmit={handleSubscriptionSubmit} className="space-y-4"><div className="space-y-3"><label className="block text-sm font-medium text-ink mb-2">Type</label><select value={subscriptionForm.kind} onChange={e => setSubscriptionForm(prev => ({ ...prev, kind: e.target.value as any }))} className="w-full px-3 py-2 rounded-border border-hairline focus:border-moss focus:ring-2 focus:ring-moss/20"><option value="ward">Ward</option><option value="circle">Circle (radius from point)</option><option value="road">Road</option></select></div>{subscriptionForm.kind === 'ward' && <div className="space-y-3"><label className="block text-sm font-medium text-ink mb-2">Ward</label><select value={subscriptionForm.ward} onChange={e => setSubscriptionForm(prev => ({ ...prev, ward: e.target.value }))} className="w-full px-3 py-2 rounded-border border-hairline focus:border-moss focus:ring-2 focus:ring-moss/20"><option value="">Select Ward</option><option value="Ward 6">Ward 6</option><option value="Ward 7">Ward 7</option><option value="Ward 8">Ward 8</option></select></div>}{subscriptionForm.kind === 'circle' && <div className="space-y-3"><div className="grid grid-cols-2 gap-3"><div><label className="block text-sm font-medium text-ink mb-2">Latitude</label><input type="number" step="any" value={subscriptionForm.center_lat || ''} onChange={e => setSubscriptionForm(prev => ({ ...prev, center_lat: parseFloat(e.target.value) || null }))} className="w-full px-3 py-2 rounded-border border-hairline focus:border-moss focus:ring-2 focus:ring-moss/20" placeholder="Center latitude" /></div><div><label className="block text-sm font-medium text-ink mb-2">Longitude</label><input type="number" step="any" value={subscriptionForm.center_lng || ''} onChange={e => setSubscriptionForm(prev => ({ ...prev, center_lng: parseFloat(e.target.value) || null }))} className="w-full px-3 py-2 rounded-border border-hairline focus:border-moss focus:ring-2 focus:ring-moss/20" placeholder="Center longitude" /></div></div><div><label className="block text-sm font-medium text-ink mb-2">Radius (meters)</label><input type="number" min="100" max="50000" value={subscriptionForm.radius_m || ''} onChange={e => setSubscriptionForm(prev => ({ ...prev, radius_m: parseInt(e.target.value) || 1000 }))} className="w-full px-3 py-2 rounded-border border-hairline focus:border-moss focus:ring-2 focus:ring-moss/20" /></div></div>}{subscriptionForm.kind === 'road' && <div className="space-y-3"><label className="block text-sm font-medium text-ink mb-2">Road Name</label><input type="text" value={subscriptionForm.road_name} onChange={e => setSubscriptionForm(prev => ({ ...prev, road_name: e.target.value }))} className="w-full px-3 py-2 rounded-border border-hairline focus:border-moss focus:ring-2 focus:ring-moss/20" placeholder="e.g., Lake View Road" /></div>}<div className="flex items-center gap-3 mt-6"><button type="button" onClick={() => setShowCreateModal(false)} className="flex-1 px-3 py-2 rounded-border border-hairline text-sm font-medium text-ink">Cancel</button><button type="submit" className="flex-1 bg-moss hover:bg-moss-light text-white px-4 py-2 rounded-md font-medium">Create Subscription</button></div></form></div></div>}
    </div>
  );
};

export default Alerts;