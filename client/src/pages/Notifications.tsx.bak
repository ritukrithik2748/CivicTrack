import React, { useState, useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';
import { useNotifications } from '../contexts/NotificationContext';

const Notifications: React.FC = () => {
  const { user } = useAuth();
  const { unreadCount, notifications, markAsRead, markAllAsRead, fetchNotifications } = useNotifications();
  const [filter, setFilter] = useState<'all' | 'unread' | 'read'>('all');

  useEffect(() => {
    if (user) {
      fetchNotifications();
    }
  }, [user]);

  const filteredNotifications = notifications.filter(n => {
    if (filter === 'unread') return !n.read;
    if (filter === 'read') return n.read;
    return true;
  });

  if (!user) {
    return (
      <div className="min-h-screen bg-panel flex items-center justify-center">
        <div className="text-center py-12">
          <h2 className="text-2xl font-heading text-dtext mb-4">Please Log In</h2>
          <p className="text-body text-muted mb-6">You need to be logged in to view notifications.</p>
          <Link to="/login" className="bg-moss hover:bg-moss-light text-white px-6 py-3 rounded-md">Login</Link>
        </div>
      </div>
    );
  }

  const getTypeColor = (type: string) => {
    switch (type) {
      case 'reply': return 'bg-lagoon/20 text-lagoon';
      case 'reopen': return 'bg-saffron/20 text-saffron';
      case 'escalation': return 'bg-brick/20 text-brick';
      case 'delay': return 'bg-saffron/20 text-saffron';
      case 'work_scheduled': return 'bg-moss/20 text-moss';
      case 'verified': return 'bg-lagoon/20 text-lagoon';
      case 'dispute': return 'bg-disputed/20 text-disputed';
      case 'reassignment': return 'bg-saffron/20 text-saffron';
      case 'released': return 'bg-moss/20 text-moss';
      case 'early_warning': return 'bg-brick/20 text-brick';
      default: return 'bg-ink/20 text-dtext';
    }
  };

  return (
    <div className="min-h-screen bg-panel">
      {/* Header */}
      <header className="bg-panel border-b border-line">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex flex-col md:flex-row md:items-center md:justify-between py-4">
            <div className="flex-1">
              <h1 className="text-2xl font-heading text-dtext mb-2">Notifications</h1>
              <p className="text-body text-muted">Stay informed about your department's activities</p>
            </div>
            <div className="flex items-center space-x-3">
              <Link to="/dashboard" className="px-3 py-1 rounded-md text-sm font-medium text-dtext hover:bg-panel-2">← Dashboard</Link>
            </div>
          </div>
        </div>
      </header>

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* Filter Tabs */}
        <div className="mb-6">
          <div className="border-b border-line">
            <nav className="flex space-x-8" aria-label="Notification filters">
              <button
                onClick={() => setFilter('all')}
                className={`py-2 border-b-2 text-sm font-medium ${filter === 'all' ? 'border-moss text-moss' : 'border-transparent text-muted'}`}
              >
                All ({notifications.length})
              </button>
              <button
                onClick={() => setFilter('unread')}
                className={`py-2 border-b-2 text-sm font-medium ${filter === 'unread' ? 'border-moss text-moss' : 'border-transparent text-muted'}`}
              >
                Unread ({unreadCount})
              </button>
              <button
                onClick={() => setFilter('read')}
                className={`py-2 border-b-2 text-sm font-medium ${filter === 'read' ? 'border-moss text-moss' : 'border-transparent text-muted'}`}
              >
                Read ({notifications.filter(n => n.read).length})
              </button>
            </nav>
          </div>
        </div>

        {/* Notifications List */}
        <div className="bg-white rounded-xl shadow-sm border border-line">
          {filteredNotifications.length > 0 ? (
            <div className="divide-y divide-line">
              {filteredNotifications.map((notif: any) => (
                <div
                  key={notif.id}
                  className={`p-4 ${!notif.read ? 'bg-moss/5' : ''}`}
                >
                  <div className="flex items-start gap-3">
                    <div className="flex-shrink-0">
                      <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${getTypeColor(notif.type)}`}>
                        {notif.type}
                      </span>
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="flex items-start justify-between gap-3">
                        <div>
                          <h3 className={`font-medium ${!notif.read ? 'text-dtext' : 'text-muted'}`}>
                            {notif.title}
                          </h3>
                          <p className={`text-sm ${!notif.read ? 'text-dtext' : 'text-muted'} mt-1`}>
                            {notif.body}
                          </p>
                        </div>
                        <div className="flex items-center gap-2 flex-shrink-0">
                          <span className="text-xs text-muted">
                            {new Date(notif.created_at).toLocaleString()}
                          </span>
                          {notif.link && (
                            <a
                              href={notif.link}
                              className="px-2 py-1 text-xs font-medium text-moss hover:text-moss/80 bg-moss/10 rounded"
                            >
                              View
                            </a>
                          )}
                          {!notif.read && (
                            <button
                              onClick={() => markAsRead(notif.id)}
                              className="p-1 text-muted hover:text-moss"
                              aria-label="Mark as read"
                            >
                              <svg className="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                              </svg>
                            </button>
                          )}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div className="text-center py-12 text-muted">
              <p>{filter === 'unread' ? 'No unread notifications' : filter === 'read' ? 'No read notifications' : 'No notifications yet'}</p>
            </div>
          )}

          {/* Mark all as read button */}
          {unreadCount > 0 && filter === 'all' && (
            <div className="p-4 border-t border-line">
              <button
                onClick={() => markAllAsRead()}
                className="w-full bg-saffron/10 hover:bg-saffron/20 text-saffron px-4 py-2 rounded-md font-medium"
              >
                Mark all {unreadCount} as read
              </button>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};

export default Notifications;