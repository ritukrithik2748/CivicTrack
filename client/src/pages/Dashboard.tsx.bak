import React, { useState, useEffect } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';
import { useNotifications } from '../contexts/NotificationContext';
import { useDashboardStats } from '../hooks/useDashboardStats';

const Dashboard: React.FC = () => {
  const { user } = useAuth();
  const { unreadCount, notify } = useNotifications();
  const { stats, isLoading, error } = useDashboardStats(user?.department_id || '');
  const navigate = useNavigate();

  useEffect(() => {
    // Check for notifications
    // In a real app, we'd have a subscription or polling mechanism
  }, [unreadCount]);

  if (isLoading) {
    return (
      <div className="min-h-screen bg-panel flex items-center justify-center">
        <div className="animate-pulse">
          <div className="h-4 w-24 rounded bg-line/20 mb-2"></div>
          <div className="h-4 w-32 rounded bg-line/20"></div>
        </div>
      </div>
    );
