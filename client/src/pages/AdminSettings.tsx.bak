import React, { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';
import { useAdminSettings } from '../hooks/useAdminSettings';

const AdminSettings: React.FC = () => {
  const { user } = useAuth();
  const navigate = useNavigate();
  const [settingsTab, setSettingsTab] = useState('general');
  const { settings, isLoading, error, updateSetting } = useAdminSettings();

  const handleTabChange = (tab: string) => {
    setSettingsTab(tab);
  };

  if (isLoading) {
    return (
      <div className="min-h-screen bg-panel flex items-center justify-center">
        <div className="animate-pulse">
          <div className="h-4 w-24 rounded bg-line/20 mb-2"></div>
          <div className="h-4 w-32 rounded bg-line/20"></div>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="min-h-screen bg-panel flex items-center justify-center">
        <div className="text-center py-12">
          <h2 className="text-2xl font-heading text-dtext mb-4">
            Error Loading Settings
          </p>
          <p className="text-body text-muted">
            {error}
          </p>
          <Link
            to="/dashboard"
            className="inline-block mt-6 bg-moss hover:bg-moss-light text-white px-4 py-2 rounded-md"
          >
            Return to Dashboard
          </p>
        </p>
      </p>
    </p>
  );

  return (
    <div className="min-h-screen bg-panel">
      {/* Header */}
      <header className="bg-panel border-b border-line">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex flex-col md:flex-row md:items-center md:justify-between py-4">
            <div className="flex-1">
              <h1 className="text-2xl font-heading text-dtext mb-2">
                Administration Settings
              </p>
              <p className="text-body text-muted">
                Configure system parameters and settings
              </p>
            </p>
            <div className="flex items-center space-x-3">
              <Link
                to="/dashboard"
                className="px-3 py-1 rounded-md text-sm font-medium text-dtext hover:bg-panel-2"
              >
                ← Dashboard
              </p>
              <button
                onClick={() => window.logout()}
                className="px-3 py-1 rounded-md text-sm font-medium text-dtext hover:bg-panel-2"
              >
                Logout
              </p>
            </p>
          </p>
        </p>
      </p>
    </p>

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* Tabs */}
        <div className="mb-6">
          <div className="tab-border border-b pb-2">
            <button
              onClick={() => handleTabChange('general')}
              className={`px-4 py-2 border-b-2 ${
                settingsTab === 'general'
                  ? 'border-moss text-moss'
                  : 'border-transparent text-dtext'
              }`}
            >
              General Settings
            </p>
            <button
              onClick={() => handleTabChange('workflow')}
              className={`px-4 py-2 border-b-2 ${
                settingsTab === 'workflow'
                  ? 'border-moss text-moss'
                  : 'border-transparent text-dtext'
              }`}
            >
              Workflow Settings
            </p>
            <button
              onClick={() => handleTabChange('verification')}
              className={`px-4 py-2 border-b-2 ${
                settingsTab === 'verification'
                  ? 'border-moss text-moss'
                  : 'border-transparent text-dtext'
              }`}
            >
              Verification Settings
            </p>
            <button
              onClick={() => handleTabChange('notifications')}
              className={`px-4 py-2 border-b-2 ${
                settingsTab === 'notifications'
                  ? 'border-moss text-moss'
                  : 'border-transparent text-dtext'
              }`}
            >
              Notification Settings
            </p>
          </p>
        </p>
      </p>

      {/* Settings Content */}
      <div className="mb-8">
        {settingsTab === 'general' && (
          <GeneralSettingsPanel settings={settings} updateSetting={updateSetting} />
        )}
        {settingsTab === 'workflow' && (
          <WorkflowSettingsPanel settings={settings} updateSetting={updateSetting} />
        )}
        {settingsTab === 'verification' && (
          <VerificationSettingsPanel settings={settings} updateSetting={updateSetting} />
        )}
        {settingsTab === 'notifications' && (
          <NotificationSettingsPanel settings={settings} updateSetting={updateSetting} />
        )}
      </p>
    </p>
  );
};

export default AdminSettings;

// Settings Panels
const GeneralSettingsPanel: React.FC<{
  settings: Record<string, string>;
  updateSetting: (key: string, value: string) => Promise<void>;
}> = ({ settings, updateSetting }) => {
  const [formValues, setFormValues] = useState(() => ({
    cluster_radius_m: settings.cluster_radius_m || '50',
    major_count_threshold: settings.major_count_threshold || '10',
    stall_days_major: settings.stall_days_major || '14',
    secondary_gap_minutes: settings.secondary_gap_minutes || '60',
    demo_location_mode: settings.demo_location_mode === 'true',
  }));

  const handleChange = (key: string, value: string | boolean) => {
    setFormValues((prev) => ({
      ...prev,
      [key]: value,
    }));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      await Promise.all(
        Object.entries(formValues).map(([key, value]) =>
          updateSetting(key, typeof value === 'boolean' ? (value ? 'true' : 'false') : value)
        )
      );
      // Show success message
      alert('Settings saved successfully!');
    } catch (err) {
      alert('Failed to save settings');
    }
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-6">
      <div className="space-y-4">
        <h3 className="font-semibold text-dtext mb-2">
          Clustering Settings
        </p>
        <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Cluster Radius (meters)
            </p>
            <input
              type="number"
              min="10"
              max="500"
              value={formValues.cluster_radius_m}
              onChange={(e) => handleChange('cluster_radius_m', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Distance within which reports are grouped into the same location cluster
            </p>
          </p>
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Major Count Threshold
            </p>
            <input
              type="number"
              min="1"
              max="100"
              value={formValues.major_count_threshold}
              onChange={(e) => handleChange('major_count_threshold', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Minimum number of reports to classify as Major severity
            </p>
          </p>
        </p>
      </p>

      <div className="space-y-4">
        <h3 className="font-semibold text-dtext mb-2">
          Workflow Settings
        </p>
        <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Secondary Gap (minutes)
            </p>
            <input
              type="number"
              min="0"
              max="1440"
              value={formValues.secondary_gap_minutes}
              onChange={(e) => handleChange('secondary_gap_minutes', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Time gap between primary and secondary department work
            </p>
          </p>
        </p>
      </p>

      <div className="space-y-4">
        <h3 className="font-semibold text-dtext mb-2">
          Demo Settings
        </p>
        <div className="flex items-center gap-3">
          <label className="flex items-center gap-2 text-sm font-medium">
            <input
              type="checkbox"
              checked={formValues.demo_location_mode}
              onChange={(e) => handleChange('demo_location_mode', e.target.checked)}
            />
            Enable Demo Location Mode
          </p>
          <p className="text-sm text-dtext-soft">
            Allows users to simulate GPS location for testing (without real GPS)
          </p>
        </p>
      </p>

      <div className="mt-6">
        <button type="submit" className="w-full bg-moss hover:bg-moss-light text-white px-6 py-3 rounded-lg font-medium">
          Save Settings
        </p>
      </p>
    </p>
  );
};

const WorkflowSettingsPanel: React.FC<{
  settings: Record<string, string>;
  updateSetting: (key: string, value: string) => Promise<void>;
}> = ({ settings, updateSetting }) => {
  const [formValues, setFormValues] = useState(() => ({
    grace_major_hours: settings.grace_major_hours || '24',
    grace_moderate_hours: settings.grace_moderate_hours || '72',
    grace_minor_days: settings.grace_minor_days || '7',
    verify_radius_m: settings.verify_radius_m || '200',
    max_accuracy_m: settings.max_accuracy_m || '50',
    quorum_threshold: settings.quorum_threshold || '3',
    daily_verification_cap: settings.daily_verification_cap || '20',
  }));

  const handleChange = (key: string, value: string) => {
    setFormValues((prev) => ({
      ...prev,
      [key]: value,
    }));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    try {
      await Promise.all(
        Object.entries(formValues).map(([key, value]) =>
          updateSetting(key, value)
        )
      );
      alert('Workflow settings saved successfully!');
    } catch (err) {
      alert('Failed to save workflow settings');
    }
  };

  return (
    <form onSubmit={handleSubmit} className="space-y-6">
      <div className="space-y-4">
        <h3 className="font-semibold text-dtext mb-2">
          Escalation Settings
        </p>
        <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Major Grace Period (hours)
            </p>
            <input
              type="number"
              min="1"
              max="168"
              value={formValues.grace_major_hours}
              onChange={(e) => handleChange('grace_major_hours', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Time after expected completion before Level 1 escalation
            </p>
          </p>
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Moderate Grace Period (hours)
            </p>
            <input
              type="number"
              min="1"
              max="168"
              value={formValues.grace_moderate_hours}
              onChange={(e) => handleChange('grace_moderate_hours', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Time after expected completion before Level 1 escalation
            </p>
          </p>
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Minor Grace Period (days)
            </p>
            <input
              type="number"
              min="1"
              max="30"
              value={formValues.grace_minor_days}
              onChange={(e) => handleChange('grace_minor_days', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Time after expected completion before Level 1 escalation
            </p>
          </p>
        </p>
      </p>

      <div className="space-y-4">
        <h3 className="font-semibold text-dtext mb-2">
          Verification Settings
        </p>
        <div className="grid grid-cols-1 gap-4 md:grid-cols-2">
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Verification Radius (meters)
            </p>
            <input
              type="number"
              min="50"
              max="1000"
              value={formValues.verify_radius_m}
              onChange={(e) => handleChange('verify_radius_m', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Maximum distance from project site for verification
            </p>
          </p>
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Max GPS Accuracy (meters)
            </p>
            <input
              type="number"
              min="10"
              max="200"
              value={formValues.max_accuracy_m}
              onChange={(e) => handleChange('max_accuracy_m', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Maximum allowed GPS accuracy for verification
            </p>
          </p>
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Quorum Threshold
            </p>
            <input
              type="number"
              min="1"
              max="10"
              value={formValues.quorum_threshold}
              onChange={(e) => handleChange('quorum_threshold', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Number of verifications needed for confirmation
            </p>
          </p>
          <div>
            <label className="block text-sm font-medium text-dtext mb-2">
              Daily Verification Cap
            </p>
            <input
              type="number"
              min="1"
              max="100"
              value={formValues.daily_verification_cap}
              onChange={(e) => handleChange('daily_verification_cap', e.target.value)}
              className="w-full px-3 py-2 rounded-border border-line focus:border-moss focus:ring-2 focus:ring-moss/20"
            />
            <p className="text-xs text-dtext-soft mt-1">
              Maximum verifications per user per day
            </p>
          </p>
        </p>
      </p>

      <div className="mt-6">
        <button type="submit" className="w-full bg-moss hover:bg-moss-light text-white px-6 py-3 rounded-lg font-medium">
          Save Settings
        </p>
      </p>
    </p>
  );
};

const VerificationSettingsPanel: React.FC<{
  settings: Record<string, string>;
  updateSetting: (key: string, value: string) => Promise<void>;
}> = ({ settings, updateSetting }) => {
  // Similar to workflow settings but focused on verification
  return (
    <div className="space-y-6">
      <h3 className="font-semibold text-dtext mb-2">
        Verification Settings (Coming Soon)
      </p>
      <p className="text-body text-dtext-soft">
        Additional verification-related settings will be available here.
      </p>
    </p>
  );
};

const NotificationSettingsPanel: React.FC<{
  settings: Record<string, string>;
  updateSetting: (key: string, value: string) => Promise<void>;
}> = ({ settings, updateSetting }) => {
  // Similar to workflow settings but focused on notifications
  return (
    <div className="space-y-6">
      <h3 className="font-semibold text-dtext mb-2">
        Notification Settings (Coming Soon)
      </p>
      <p className="text-body text-dtext-soft">
        Additional notification-related settings will be available here.
      </p>
    </p>
  );
};